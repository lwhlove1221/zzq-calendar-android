<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Calendar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Calendar.Dialog</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="ThemeOverlay.Calendar.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="ThemeOverlay.Calendar.Accent.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/on_accent_blue</item>
        <item name="colorPrimaryContainer">@color/accent_soft_blue</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_soft_blue</item>
    </style>

    <style name="ThemeOverlay.Calendar.Accent.Green" parent="">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorOnPrimary">@color/on_accent_green</item>
        <item name="colorPrimaryContainer">@color/accent_soft_green</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_soft_green</item>
    </style>

    <style name="ThemeOverlay.Calendar.Accent.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/on_accent_purple</item>
        <item name="colorPrimaryContainer">@color/accent_soft_purple</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_soft_purple</item>
    </style>
</resources>
